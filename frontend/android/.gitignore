# --- Gradle wrapper ---
# Defensive whitelist: never let a future *.jar rule accidentally drop the
# Gradle wrapper jar. CI's ./gradlew requires this file at
# gradle/wrapper/gradle-wrapper.jar or the build cannot start.
!gradle/wrapper/gradle-wrapper.jar
!gradle-wrapper.jar
